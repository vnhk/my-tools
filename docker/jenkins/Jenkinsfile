pipeline {
    agent { label 'my-tools-builder' }
    options {
        copyArtifactPermission('my-tools-deploy')
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '3'))
        timestamps()
    }
    parameters {
        booleanParam(name: 'FORCE_REBUILD', defaultValue: false,
            description: 'Ignore the successful snapshot and rebuild all source components.')
        booleanParam(name: 'RUN_INTEGRATION_TESTS', defaultValue: true,
            description: 'Run React integration tests against temporary CI databases/services.')
        booleanParam(name: 'EXPORT_IMAGES', defaultValue: true,
            description: 'Archive the built images for a later, separate production release.')
    }
    stages {
        stage('Checkout main repository') {
            steps {
                dir('sources') { deleteDir() }
                dir('release') { deleteDir() }
                dir('sources/my-tools') { checkout scm }
            }
        }
        stage('Checkout modules and record commits') {
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py checkout' }
        }
        stage('Plan changes and restore successful artifacts') {
            steps {
                sh 'python3 sources/my-tools/docker/jenkins/pipeline.py plan'
                script {
                    env.BUILD_BACKEND = sh(returnStdout: true, script: 'python3 sources/my-tools/docker/jenkins/pipeline.py flag backend').trim()
                    env.BUILD_FRONTEND = sh(returnStdout: true, script: 'python3 sources/my-tools/docker/jenkins/pipeline.py flag frontend').trim()
                    env.BUILD_INTEGRATION = sh(returnStdout: true, script: 'python3 sources/my-tools/docker/jenkins/pipeline.py flag integration').trim()
                    env.BUILD_TOOLS = sh(returnStdout: true, script: 'python3 sources/my-tools/docker/jenkins/pipeline.py flag tools').trim()
                }
            }
        }
        stage('Prepare CI tool image') {
            when { expression { env.BUILD_TOOLS == 'true' } }
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py tools' }
        }
        stage('Build and test Java backend') {
            when { expression { env.BUILD_BACKEND == 'true' } }
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py backend' }
        }
        stage('Build and type-check React frontend') {
            when { expression { env.BUILD_FRONTEND == 'true' } }
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py frontend' }
        }
        stage('Integration tests') {
            when { expression { params.RUN_INTEGRATION_TESTS && env.BUILD_INTEGRATION == 'true' } }
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py integration' }
        }
        stage('Package versioned application images') {
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py images' }
        }
        stage('Export release images') {
            when { expression { params.EXPORT_IMAGES } }
            steps { sh 'python3 sources/my-tools/docker/jenkins/pipeline.py export' }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'release/*.json,release/*.sha256,sources/**/target/surefire-reports/*.xml',
                allowEmptyArchive: true
        }
        success {
            archiveArtifacts artifacts: 'release/*.tar.gz', allowEmptyArchive: true
            sh 'python3 sources/my-tools/docker/jenkins/pipeline.py promote'
            echo 'Build completed in CI only. Production containers and production secrets were not accessed.'
        }
    }
}
